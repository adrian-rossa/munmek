{
  "manifest_version": 3,
  "name": "Munmek - Korean Context Lookup",
  "version": "1.2.0",
  "description": "Korean hover lookup with local dictionary ranking, optional Gemini explanations, and AnkiConnect exports.",
  "permissions": ["storage"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"]
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "assets/icon16.png",
      "48": "assets/icon48.png",
      "128": "assets/icon128.png"
    }
  },
  "options_page": "options.html",
  "host_permissions": [
    "https://generativelanguage.googleapis.com/*",
    "http://127.0.0.1:8765/*",
    "http://localhost:8765/*"
  ],
  "icons": {
    "16": "assets/icon16.png",
    "48": "assets/icon48.png",
    "128": "assets/icon128.png"
  },
  "web_accessible_resources": [
    {
      "resources": ["korean_words.json"],
      "matches": ["<all_urls>"]
    }
  ]
}
